<?xml version="1.0" encoding="utf-8"?>
<!--
  MdViewer installer.

  Per-user install: everything goes under the current user's profile and
  HKEY_CURRENT_USER, so Windows never asks for administrator rights.
  Build it with installer\build-installer.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="MdViewer"
           Manufacturer="Sergei Chesnokov"
           Version="$(var.Version)"
           UpgradeCode="09D2B9C6-4167-4666-8532-03026B80E649"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="MdViewer - lightweight Markdown viewer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of MdViewer is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.IconSource)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCONTACT" Value="Sergei Chesnokov" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="MdViewer" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="MdViewer" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppComponents">

      <!-- The published application: the executable plus the bundled .NET runtime. -->
      <Files Include="$(var.PublishDir)\**" Directory="INSTALLFOLDER" />

      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="MdViewerShortcut"
                  Name="MdViewer"
                  Description="Lightweight Markdown viewer"
                  Target="[INSTALLFOLDER]MdViewer.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\MdViewer" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Opens Markdown files with MdViewer, for this user only. -->
      <Component Id="FileAssociation" Directory="INSTALLFOLDER">
        <RegistryKey Root="HKMU" Key="Software\Classes\MdViewer.Markdown">
          <RegistryValue Type="string" Value="Markdown Document" KeyPath="yes" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[INSTALLFOLDER]MdViewer.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]MdViewer.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>

        <RegistryKey Root="HKMU" Key="Software\Classes\.md">
          <RegistryValue Type="string" Value="MdViewer.Markdown" />
          <RegistryKey Key="OpenWithProgids">
            <RegistryValue Name="MdViewer.Markdown" Type="string" Value="" />
          </RegistryKey>
        </RegistryKey>

        <RegistryKey Root="HKMU" Key="Software\Classes\.markdown">
          <RegistryValue Type="string" Value="MdViewer.Markdown" />
          <RegistryKey Key="OpenWithProgids">
            <RegistryValue Name="MdViewer.Markdown" Type="string" Value="" />
          </RegistryKey>
        </RegistryKey>

        <RegistryKey Root="HKMU" Key="Software\Classes\.mdown">
          <RegistryValue Type="string" Value="MdViewer.Markdown" />
        </RegistryKey>

        <RegistryKey Root="HKMU" Key="Software\Classes\.mkd">
          <RegistryValue Type="string" Value="MdViewer.Markdown" />
        </RegistryKey>

        <RegistryKey Root="HKMU" Key="Software\Classes\.mdtext">
          <RegistryValue Type="string" Value="MdViewer.Markdown" />
        </RegistryKey>
      </Component>

    </ComponentGroup>
  </Fragment>
</Wix>
