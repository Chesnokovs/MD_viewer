<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MdViewer</RootNamespace>
    <AssemblyName>MdViewer</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.0</Version>
    <Product>MdViewer</Product>
    <Description>Lightweight Markdown file viewer</Description>
    <Company>Sergei Chesnokov</Company>
    <Copyright>Copyright (c) 2026 Sergei Chesnokov</Copyright>
    <!-- Single-file publish keeps the whole app in one .exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Reference XML documentation would otherwise be copied next to the exe. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- The WebView2 package also ships a WPF assembly we do not use. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web assets are embedded into the exe and served from memory at runtime -->
    <EmbeddedResource Include="assets\viewer.html" />
    <EmbeddedResource Include="assets\viewer.css" />
    <EmbeddedResource Include="assets\viewer.js" />
    <EmbeddedResource Include="assets\highlight.min.js" />
    <!-- Generated from tools\hljs-themes by tools\make_hljs_css.py -->
    <EmbeddedResource Include="assets\hljs.css" />
    <!-- Also the window icon, loaded at every size so it stays crisp -->
    <EmbeddedResource Include="assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives below this folder; keep its sources out of the app. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The link and file rules in LinkPolicy are covered by tests\MdViewer.Tests -->
    <InternalsVisibleTo Include="MdViewer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
